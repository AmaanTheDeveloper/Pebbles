APP_NAME=Pebbles
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pebbles
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Public product/gallery/branding media disk (Storage public disk by default).
# MEDIA_DISK=public
# Optional CDN base URL for public media (paths are appended). Example:
# MEDIA_URL=https://cdn.example.com/storage
# QUEUE_CONNECTION=database runs OrderConfirmedMail via the queue worker.
# Production: keep database or redis (not sync) and run `php artisan queue:work`.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: use "log" locally. Production SMTP example (Laravel 12):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
MAIL_MAILER=log
# Laravel 12 uses MAIL_SCHEME (smtp|smtps). For Gmail port 587 use smtp (STARTTLS).
# Legacy MAIL_ENCRYPTION=tls|ssl is also mapped in config/mail.php when MAIL_SCHEME is unset.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=http://localhost:5173

# Bootstrap Super Admin (used by DatabaseSeeder)
SUPER_ADMIN_NAME="Pebbles Super Admin"
SUPER_ADMIN_EMAIL=superadmin@pebbles.test
SUPER_ADMIN_PASSWORD=password

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000

VITE_APP_NAME="${APP_NAME}"
# Leave blank when the SPA is served by Laravel (same origin).
# Set to the Laravel origin if the Vite app runs on a separate host/port.
VITE_API_BASE_URL=

ORDER_CANCELLATION_MINUTES=30
# Payment proofs must stay on the private local disk — never "public".
PAYMENT_PROOF_DISK=local
